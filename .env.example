# Supabase-Projekt (eigenes, separates Projekt für diese Plattform, Region
# Frankfurt). Settings -> API. Der Service-Role-Key umgeht jede Sperre in
# der Datenbank: nur in Vercel und im Passwortmanager ablegen.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Nur für die einmalige Ersteinrichtung des ersten Admin-Kontos unter
# /login. Danach wirkungslos – in Vercel wieder löschen.
PLATTFORM_ADMIN_PIN=

# Signiert die Sitzungs- und Geräte-Cookies. Ändern meldet alle ab
# (auch Tresen und gekoppelte Handys). Erzeugen: openssl rand -hex 32
SESSION_SECRET=

# Verschlüsselt die 2FA-Geheimnisse in der Datenbank. 64 Hex-Zeichen,
# erzeugen: openssl rand -hex 32. Nie nachträglich ändern, sonst müssen
# alle Konten 2FA neu einrichten. Sicher aufbewahren.
ZWEI_FAKTOR_SCHLUESSEL=

# Mailversand über Resend (Einladungen, Passwort-Links, Sicherheits-Mails,
# Reservierungs- und Bewertungsmails). Ohne Key wird nur geloggt – für den
# Live-Betrieb Pflicht, mit verifizierter Absende-Domain.
RESEND_API_KEY=
RESEND_ABSENDER=

# Optional: Signing Secret des Resend-Webhooks (app/api/resend/webhook),
# nötig für die Klickrate im Bewertung-Modul. Bei Resend unter Webhooks ->
# Endpoint anlegen, Events "email.opened" + "email.clicked" aktivieren.
RESEND_WEBHOOK_SECRET=

# Eure Plattform-Domain (z. B. maestoso.io), OHNE "https://" und ohne
# Subdomain. Jeder Betrieb bekommt vorläufig <subdomain>.<diese Domain>,
# Admin-Login unter <diese Domain>/login. Lokal leer lassen – dann ist das
# Domain-Routing aus und alles läuft über localhost.
NEXT_PUBLIC_PLATTFORM_DOMAIN=

# Optional: Kunden-Domains direkt aus dem Plattform-Admin in Vercel anlegen,
# prüfen und entfernen. Token: Vercel -> Account Settings -> Tokens,
# Projekt-ID: Project Settings -> General, Team-ID: Team Settings (leer bei
# persönlichem Account). Ohne diese Werte Domains in Vercel von Hand eintragen.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
