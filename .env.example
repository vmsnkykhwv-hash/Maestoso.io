# Supabase-Projekt (eigenes, separates Projekt für diese Plattform)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# PIN für den Plattform-Admin-Login (du selbst – legt Organisationen an
# und schaltet Module frei). Frei wählbar, beliebige Länge.
PLATTFORM_ADMIN_PIN=

# Zufälliger, langer String zum Signieren des Login-Cookies und zum
# Hashen der Organisations-PINs in der Datenbank.
# z.B. erzeugen mit: openssl rand -hex 32
SESSION_SECRET=

# Optional: Bestätigungs-/Erinnerungsmails für Reservierungen (Tischplan-
# Modul) über Resend. Ohne RESEND_API_KEY wird die Buchung trotzdem
# gespeichert, nur der Mailversand übersprungen.
RESEND_API_KEY=
RESEND_ABSENDER=

# Eure eigene Plattform-Domain (z. B. serviceflow.app), OHNE "https://" und
# ohne Subdomain. Wird für das Website-Modul gebraucht: jede Organisation
# bekommt automatisch <subdomain>.<NEXT_PUBLIC_PLATTFORM_DOMAIN>. Lokal
# leer lassen – ohne diese Variable ist das Domain-Routing komplett
# inaktiv und alles läuft normal über localhost.
NEXT_PUBLIC_PLATTFORM_DOMAIN=
