import { chromium, type Page } from 'playwright'
import { aktuellerCode } from '../lib/konten/totp'

const PORT = 3200, CAFE = `http://cafe-test.maestoso.test:${PORT}`, ADMIN = `http://maestoso.test:${PORT}`
const ok = (b: boolean, t: string) => { console.log(b ? '✓' : '✗', t); if (!b) process.exitCode = 1 }
const sichtbar = (p: Page, text: string) => p.getByText(text).first().waitFor({ timeout: 8000 }).then(() => true, () => false)
const browser = await chromium.launch({ executablePath: process.env.CHROMIUM_PATH || undefined, args: [
  '--host-resolver-rules=MAP *.maestoso.test 127.0.0.1, MAP maestoso.test 127.0.0.1',
  `--unsafely-treat-insecure-origin-as-secure=${ADMIN},${CAFE}` ] })
const lokal = (link: string) => link.replace('https://', 'http://').replace('.maestoso.test/', `.maestoso.test:${PORT}/`)
async function zweiFa(p: Page) {
  await p.getByText('Oder von Hand eingeben').waitFor()
  const g = (await p.locator('span.font-mono').first().textContent()).replace(/\s/g, '')
  await p.getByPlaceholder('123456').fill(aktuellerCode(g))
  await p.getByRole('button', { name: 'Einrichtung abschließen' }).click()
  await p.getByRole('button', { name: 'Gesichert – weiter' }).click()
  return g
}

// Setup: Admin, Betrieb, Inhaberin
const admin = await (await browser.newContext()).newPage()
await admin.goto(`${ADMIN}/login`)
await admin.getByLabel('PLATTFORM_ADMIN_PIN').fill('482913')
await admin.getByLabel('E-Mail').fill('admin@musterbetrieb.de')
await admin.getByLabel(/^Passwort \(mind/).fill('Lange-Sichere-Phrase-77')
await admin.getByLabel('Passwort wiederholen').fill('Lange-Sichere-Phrase-77')
await admin.getByRole('button', { name: 'Admin-Konto anlegen' }).click()
await zweiFa(admin); await admin.waitForURL('**/plattform-admin')
await admin.getByPlaceholder('Name (z. B. Café Musterbetrieb)').fill('Café Test')
await admin.getByPlaceholder('E-Mail Inhaber*in').fill('inhaber@musterbetrieb.de')
await admin.getByRole('button', { name: 'Anlegen und einladen' }).click()
const link = lokal((await admin.locator('button.font-mono span').first().textContent())!)
// Alle Module freischalten (sonst überall Demo-Banner – stört hier nicht, aber realistischer)
const tablet = await (await browser.newContext()).newPage()
await tablet.goto(link)
await tablet.getByLabel(/^Neues Passwort/).fill('Kaffee-Bohnen-Tresen-42')
await tablet.getByLabel('Passwort wiederholen').fill('Kaffee-Bohnen-Tresen-42')
await tablet.getByRole('button', { name: 'Passwort festlegen' }).click()
const inhaberGeheimnis = await zweiFa(tablet)
await tablet.waitForURL('**/dashboard')

// Mitarbeiterin anlegen (Zeiterfassung → Mitarbeiter)
await tablet.goto(`${CAFE}/dashboard/zeiterfassung`)
await tablet.getByRole('button', { name: 'Mitarbeiter', exact: true }).click()
await tablet.getByPlaceholder('Name').fill('Mara Böhm')
await tablet.getByPlaceholder('PIN').fill('4711')
await tablet.getByRole('button', { name: 'Anlegen' }).click()
ok(await sichtbar(tablet, 'Mara Böhm'), 'Inhaberin legt Mitarbeiterin an')
await tablet.getByPlaceholder('Name').fill('Jonas Keller')
await tablet.getByPlaceholder('PIN').fill('4711')
await tablet.getByRole('button', { name: 'Anlegen' }).click()
ok(await sichtbar(tablet, 'schon vergeben'), 'Doppelte PIN wird abgelehnt')

// Tablet als Tresen freigeben, Inhaberin meldet sich ab
await tablet.goto(`${CAFE}/dashboard/zugaenge`)
await tablet.getByRole('button', { name: 'Dieses Gerät als Tresen freigeben' }).click()
ok(await sichtbar(tablet, '(dieses Gerät)'), 'Tablet als Tresen-Gerät freigegeben')
await tablet.getByRole('button', { name: 'Abmelden', exact: true }).click()
await tablet.waitForTimeout(1500)
await tablet.goto(`${CAFE}/dashboard`)
ok(await sichtbar(tablet, 'Deine PIN'), 'Nach Abmelden zeigt das Tablet die PIN-Anmeldung')
await tablet.getByLabel('Deine PIN').fill('9999')
await tablet.getByRole('button', { name: 'Anmelden' }).click()
ok(await sichtbar(tablet, 'Falscher PIN'), 'Falsche PIN am Tresen abgelehnt')
await tablet.getByLabel('Deine PIN').fill('4711')
await tablet.getByRole('button', { name: 'Anmelden' }).click()
ok(await sichtbar(tablet, 'Am Tresen: Mara Böhm'), 'Mitarbeiterin per PIN am Tresen angemeldet')
const nav = async (p: Page) => (await p.locator('nav ul').first().innerText()).split('\n').map((x: string) => x.trim()).filter(Boolean)
const tresenNav = await nav(tablet)
ok(!tresenNav.includes('Website') && !tresenNav.includes('Bewertung') && tresenNav.includes('Tischplan'), `Tresen-Sidebar ohne Verwaltungsmodule: ${tresenNav.join(', ')}`)
ok(!(await tablet.getByText('Zugänge & Geräte').isVisible()), 'Tresen sieht keine Zugänge & Geräte')
await tablet.goto(`${CAFE}/dashboard/website`); ok(tablet.url() === `${CAFE}/dashboard`, 'Website-Modul am Tresen gesperrt (Weiterleitung)')
await tablet.goto(`${CAFE}/dashboard/zugaenge`); ok(tablet.url() === `${CAFE}/dashboard`, 'Zugänge am Tresen gesperrt')
await tablet.goto(`${CAFE}/dashboard/tischplan`)
const tabs = await tablet.locator('main button.rounded-full').allInnerTexts()
ok(tabs.join(',') === 'Reservierungen,Blockierungen', `Tischplan-Tabs am Tresen: ${tabs.join(', ')}`)
await tablet.goto(`${CAFE}/dashboard/bestellung`)
ok((await tablet.locator('main button.rounded-full').allInnerTexts()).includes('Pausen'), 'Bestellung am Tresen: nur Bestellungen + Pausen')
await tablet.getByRole('button', { name: 'Pausen' }).click()
await tablet.getByRole('button', { name: /Min\. pausieren/ }).first().click()
await sichtbar(tablet, 'Pause jetzt aufheben')
await tablet.goto(`${CAFE}/dashboard/protokoll`); ok(tablet.url() === `${CAFE}/dashboard`, 'Änderungsprotokoll am Tresen gesperrt')
await tablet.goto(`${CAFE}/dashboard/zeiterfassung`)
ok(await sichtbar(tablet, 'Meine Zeiten') && !(await tablet.getByRole('button', { name: 'Alle Zeiten' }).isVisible()), 'Zeiterfassung am Tresen: nur eigene Zeiten')
ok(await tablet.locator('fieldset:not([disabled])').first().waitFor({ timeout: 8000 }).then(() => true, () => false), 'Zeiten am Tresen bearbeitbar')

// Inhaberin (eigenes Handy/Rechner) entzieht Tischplan für Mara und koppelt ihr Handy
const inhaber = await (await browser.newContext()).newPage()
await new Promise(r => setTimeout(r, 31000)) // neuer 30-s-Schritt (Replay-Schutz)
await inhaber.goto(`${CAFE}/team`)
await inhaber.getByLabel('E-Mail').fill('inhaber@musterbetrieb.de')
await inhaber.getByLabel('Passwort').fill('Kaffee-Bohnen-Tresen-42')
await inhaber.getByRole('button', { name: 'Weiter' }).click()
await inhaber.getByLabel('Code aus deiner Authenticator-App').fill(aktuellerCode(inhaberGeheimnis))
await inhaber.getByRole('button', { name: 'Anmelden' }).click()
await inhaber.waitForURL('**/dashboard')
await inhaber.goto(`${CAFE}/dashboard/zugaenge`)
await inhaber.getByRole('button', { name: /^Tischplan/ }).click()
await inhaber.waitForTimeout(1500)
await tablet.goto(`${CAFE}/dashboard/tischplan`)
ok(tablet.url() === `${CAFE}/dashboard`, 'Tool-Freischaltung wirkt sofort: Tischplan für Mara gesperrt')
await inhaber.getByRole('button', { name: 'Handy koppeln' }).click()
const kopplung = lokal((await inhaber.locator('p.font-mono').first().textContent())!)
ok(kopplung.includes('/team/koppeln?code='), 'Kopplungslink/QR erzeugt')

const handyCtx = await browser.newContext({ viewport: { width: 390, height: 844 } }), handy = await handyCtx.newPage()
await handy.goto(kopplung)
ok(await sichtbar(handy, 'Mara Böhm'), 'Kopplungsseite nennt die Mitarbeiterin')
await handy.getByLabel('Deine PIN').fill('1234')
await handy.getByRole('button', { name: 'Handy koppeln' }).click()
ok(await sichtbar(handy, 'Falscher PIN'), 'Kopplung mit falscher PIN abgelehnt')
await handy.getByLabel('Deine PIN').fill('4711')
await handy.getByRole('button', { name: 'Handy koppeln' }).click()
await handy.waitForURL('**/dashboard/dienstplan')
ok(true, 'Handy gekoppelt, landet im Dienstplan')
await handy.goto(`${CAFE}/dashboard/tischplan`); ok(handy.url() === `${CAFE}/dashboard`, 'Handy: Tischplan gesperrt')
await handy.goto(`${CAFE}/dashboard/gutschein`); ok(handy.url() === `${CAFE}/dashboard`, 'Handy: Gutscheine gesperrt (Tagesgeschäft nur am Tresen)')
await handy.goto(`${CAFE}/dashboard/zeiterfassung`)
ok(await handy.locator('fieldset[disabled]').first().waitFor({ timeout: 8000 }).then(() => true, () => false), 'Handy: eigene Zeiten nur lesen')
await handy.goto(`${CAFE}/dashboard`)
ok(!(await handy.getByText('Reservierungen heute').isVisible()), 'Handy: keine Betriebskennzahlen')
await handy.goto(kopplung)
ok(await sichtbar(handy, 'abgelaufen oder wurde schon benutzt'), 'Kopplungscode nur einmal nutzbar')

// Entziehen wirkt sofort
await inhaber.reload()
const zeile = inhaber.locator('li', { hasText: 'Handy von Mara' })
await zeile.getByRole('button', { name: 'Entziehen' }).click()
await inhaber.waitForTimeout(1500)
await handy.goto(`${CAFE}/dashboard/dienstplan`)
ok(handy.url() === `${CAFE}/team`, 'Entzogenes Handy kommt nicht mehr ins Dashboard')
// Änderungsprotokoll: wer hat was wann gemacht
await inhaber.goto(`${CAFE}/dashboard/protokoll`)
await sichtbar(inhaber, 'Kanal pausiert')
const prot = await inhaber.locator('main').innerText()
ok(/Mara Böhm \(.*\)[\s\S]*Kanal pausiert|Kanal pausiert[\s\S]*Mara Böhm \(/.test(prot), 'Protokoll: Pause am Tresen mit Mara als Akteurin')
ok(prot.includes('Tresen-Gerät freigegeben') && prot.includes('Mitarbeiter*in angelegt'), 'Protokoll: Inhaber-Aktionen erfasst')
ok(prot.includes('Tools geändert') && prot.includes('Gerät entzogen'), 'Protokoll: Tool-Freischaltung und Entziehen erfasst')
// Eingriffe des Plattform-Admins stehen im Protokoll des Betriebs
await admin.reload()
await admin.getByPlaceholder('Name', { exact: true }).fill('Fremdes Konto')
await admin.getByPlaceholder('E-Mail', { exact: true }).fill('support-test@musterbetrieb.de')
await admin.getByRole('button', { name: 'Einladen', exact: true }).click()
await admin.waitForTimeout(2000)
await inhaber.goto(`${CAFE}/dashboard/protokoll`)
await sichtbar(inhaber, 'Maestoso-Support')
const prot2 = await inhaber.locator('main').innerText()
ok(/Maestoso-Support \(admin@musterbetrieb\.de\) · Verwaltungskonto eingeladen/.test(prot2) && prot2.includes('support-test@musterbetrieb.de'), 'Protokoll: Admin-Einladung als Maestoso-Support sichtbar')
const fs = await import('node:fs')
const log = fs.readFileSync(process.env.E2E_NEXT_LOG ?? 'e2e/next.log', 'utf8')
ok(log.includes('Mail "Sicherheitshinweis: Änderung an den Zugängen von Café Test" übersprungen'), 'Sicherheitshinweis-Mail an die Inhaberin ausgelöst (ohne Resend nur geloggt)')
await browser.close()
